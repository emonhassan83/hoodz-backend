{
  "name": "hoodz-backend-nodemailer",
  "version": "1.0.0",
  "description": "Standalone SMTP mail service for Hoodz Backend",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json -w",
    "start": "node ./dist/index.js",
    "start:dev": "nodemon",
    "dev": "nodemon",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.{ts,js}\" --quiet"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "nodemailer": "^10.6.1"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "qs@<6.16.0": "^6.16.0",
      "js-yaml@>=5.0.0 <=5.4.0": "^5.4.1",
      "proxy-addr@>=1.1.0 <2.0.8": "^2.0.8",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "qs@>=6.7.0 <=6.16.0": "^6.16.1",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12"
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
